# Configuración para Yui Bot WhatsApp (Render Web Service)

# 1. API Key de Google Gemini (Google AI Studio)
# En Render, agrégala en la pestaña "Environment" como GEMINI_API_KEY
GEMINI_API_KEY=tu_api_key_de_google_ai_studio

# 2. Puerto del Servidor Web (En Render, Render lo inyecta automáticamente en process.env.PORT)
PORT=3000

# 3. Ruta de Almacenamiento de Sesión (Opcional)
# Predeterminado: ./sesion_auth
# Si configuras un Render Persistent Disk montado en /var/data, puedes indicar SESSION_DIR=/var/data
SESSION_DIR=./sesion_auth

# 4. Base de Datos en la Nube (Opcional - MongoDB Atlas Gratuito)
# Si deseas que los balances de economía y las waifus reclamadas se guarden en la nube
# y nunca se pierdan al reiniciar o desplegar en Render, crea un cluster gratuito en https://www.mongodb.com/atlas
# y agrega la variable MONGODB_URI en la pestaña Environment de Render:
# MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority
#
# (Si no configuras MongoDB, el bot guardará automáticamente todo en archivos locales JSON en ./sesion_auth)
MONGODB_URI=

