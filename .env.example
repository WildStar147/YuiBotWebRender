# Configuración para Yui Bot WhatsApp (Render Web Service)

# 1. API Key de Google Gemini (Google AI Studio)
# En Render, agrégala en la pestaña "Environment" como GEMINI_API_KEY
GEMINI_API_KEY=tu_api_key_de_google_ai_studio

# 2. Puerto del Servidor Web (En Render, Render lo inyecta automáticamente en process.env.PORT)
PORT=3000

# 3. Ruta de Almacenamiento de Sesión (Opcional)
# Predeterminado: ./sesion_auth
# Si configuras un Render Persistent Disk montado en /var/data, puedes indicar SESSION_DIR=/var/data
SESSION_DIR=./sesion_auth

# 4. Cookies para Bypass en Servidores Cloud (YouTube e Instagram)
# En servidores en la nube como Render (Linux/AWS), YouTube e Instagram bloquean IPs de datacenters con HTTP 429.
# Tienes dos formas fáciles de agregarlo en tu panel de Render:
#
# Opción A (Variable de Entorno):
# - Ve a tu servicio en Render -> pestaña "Environment".
# - Agrega una variable llamada COOKIES (o YOUTUBE_COOKIES).
# - En Value pega todo el texto de tu cookies.txt (o en formato base64).
#
# Opción B (Secret File en Render):
# - Ve a tu servicio en Render -> pestaña "Environment" -> botón "Add Secret File".
# - Nombre del archivo: cookies.txt
# - Contenido: Pega todo el contenido exportado de cookies.txt.
#
# COOKIES=

