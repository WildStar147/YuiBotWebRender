# Configuración para Yui Bot WhatsApp (Render Web Service)

# 1. API Key de Google Gemini (Opcional)
# Si deseas usar la API oficial de Google Gemini, coloca tu API Key de https://aistudio.google.com/
# Si no la configuras, Yui usará automáticamente su motor de IA gratuito de respaldo.
GEMINI_API_KEY=

# 2. Puerto del Servidor Web (En Render, Render lo inyecta automáticamente en process.env.PORT)
PORT=3000

# 3. Ruta de Almacenamiento de Sesión (Opcional)
# Predeterminado: ./sesion_auth
# Si configuras un Render Persistent Disk montado en /var/data, puedes indicar SESSION_DIR=/var/data
SESSION_DIR=./sesion_auth

